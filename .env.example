# Copy this file to .env and fill in your SMTP details.
# With Gmail: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Tip: for a quiz with no trace to any personal account, use a dedicated
# email address created just for sending these results.
#
# NO CREDENTIALS YET? Just run the app. With no SMTP settings it starts in
# TEST MODE: every submission's email is genuinely sent, captured by a
# throwaway Ethereal inbox, and the results page shows an "open the exact
# email" preview link so you can inspect what would have been delivered.
# Set EMAIL_MODE=off to disable email entirely instead.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Desire Discovery Quiz <your-sending-address@example.com>"

# OPTIONAL: if set, a full copy of each submission (answers + results) is
# also emailed here, and the consent notice automatically discloses that a
# copy is kept by the quiz administrator. Leave unset for participant-only
# delivery with no copy going anywhere else.
# ADMIN_EMAIL=

# ---- Production settings (all optional, sensible defaults) ----

# PORT=3000

# Save a JSON backup of every submission to ./submissions/ (on|off, default on).
# SAVE_SUBMISSIONS=on

# Delete saved submissions older than this many days (default 30, 0 = keep forever).
# SUBMISSION_RETENTION_DAYS=30

# Proxy hops in front of the app, so rate limiting sees real client IPs.
# Render/Railway/Fly/nginx = 1 (the default). Running directly = 0.
# TRUST_PROXY=1
