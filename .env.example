# Copy this file to .env and fill in your SMTP details.
# With Gmail: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mizdonstudios@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=mizdonstudios@gmail.com

# Where each submission is emailed
RESULTS_EMAIL=mizdonstudios@gmail.com

