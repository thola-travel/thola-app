# Copy this file to .env and fill in your SMTP details.
# With Gmail: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Tip: for a quiz with no trace to any personal account, use a dedicated
# email address created just for sending these results.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Desire Discovery Quiz <your-sending-address@example.com>"

# OPTIONAL: if set, a full copy of each submission (answers + results) is
# also emailed here, and the consent notice automatically discloses that a
# copy is kept by the quiz administrator. Leave unset for participant-only
# delivery with no copy going anywhere else.
# ADMIN_EMAIL=

# PORT=3000
