# Copy this file to .env and configure ONE email provider.
#
# OPTION A (recommended, works everywhere including hosts that block SMTP,
# e.g. Render's free tier): Resend, which delivers over HTTPS.
# 1. Create a free account at https://resend.com and make an API key.
# 2. Set RESEND_API_KEY below.
# 3. To send to participants, verify a domain in Resend and set RESEND_FROM
#    to an address on it. The default onboarding@resend.dev sender can only
#    deliver to the Resend account owner's own address (fine for testing).
# RESEND_API_KEY=
# RESEND_FROM="Desire Discovery Assessment <reports@yourdomain.com>"

# OPTION B: classic SMTP.
# With Gmail: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Tip: for a quiz with no trace to any personal account, use a dedicated
# email address created just for sending these results.
# If both providers are set, Resend takes precedence.
#
# NO CREDENTIALS YET? Just run the app. With no SMTP settings it starts in
# TEST MODE: every submission's email is genuinely sent, captured by a
# throwaway Ethereal inbox, and the results page shows an "open the exact
# email" preview link so you can inspect what would have been delivered.
# Set EMAIL_MODE=off to disable email entirely instead.

SMTP_HOST=smtp.gmail.com
# Use 465 (SMTP_SECURE=true) or 587 (SMTP_SECURE=false). Never 25: most
# hosts block it, and Render blocks it on every tier (its free tier blocks
# all outbound SMTP ports, so email needs a paid instance there).
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Desire Discovery Quiz <your-sending-address@example.com>"

# OPTIONAL: if set, a full copy of each submission (answers + results) is
# also emailed here. This is the durable data-collection channel on hosts
# with ephemeral disks. The consent notice covers this collection.
# ADMIN_EMAIL=

# OPTIONAL: a long random secret (16+ chars) that enables the owner-only
# data export. With it set, GET /api/export?token=YOUR_TOKEN returns every
# submission currently stored on the server as JSON. Leave unset to keep
# the endpoint disabled. Generate one with: openssl rand -hex 24
# ADMIN_TOKEN=

# ---- Production settings (all optional, sensible defaults) ----

# PORT=3000

# Save a JSON backup of every submission to ./submissions/ (on|off, default on).
# SAVE_SUBMISSIONS=on

# Delete saved submissions older than this many days (default 30, 0 = keep forever).
# SUBMISSION_RETENTION_DAYS=30

# Proxy hops in front of the app, so rate limiting sees real client IPs.
# Render/Railway/Fly/nginx = 1 (the default). Running directly = 0.
# TRUST_PROXY=1
